# ---------------------------------------------------------------
# IL-TOD (ИЛ ТОД) environment variables. Copy to `.env` and fill in.
# Never commit real values. GitHub Actions reads the same names
# from repository secrets.
# ---------------------------------------------------------------

# Supabase PostgreSQL. Use the "Transaction pooler" connection string
# (port 6543) for Vercel/GitHub Actions. Example:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=""

# Tier 1: DeepSeek (bulk extraction / summarization)
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"

# Tier 2: xAI Grok (deep investigative analysis on high-risk items)
GROK_API_KEY=""
GROK_MODEL="grok-4-fast"

# Tier 3: Local Ollama fallback (zero cost, dev machines only)
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="qwen3.5:4b"

# Optional price overrides in USD per 1M tokens (defaults live in src/lib/ai/pricing.ts)
# DEEPSEEK_PRICE_IN="0.15"
# DEEPSEEK_PRICE_OUT="0.60"
# GROK_PRICE_IN="2"
# GROK_PRICE_OUT="6"

# Admin panel (/admin) password. Use a long random string.
ADMIN_SECRET_PASSWORD=""

# Public site settings
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GITHUB_REPO="https://github.com/tmorius-eng/UNENMEDEE"
